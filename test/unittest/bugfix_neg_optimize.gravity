#unittest {
	name: "NEG optimization produces correct result.";
	result: true;
};

func main() {
    // The optimizer folds LOADI+NEG into a single negated LOADI.
    // Before fix, the result was written to the wrong register.
    var a = -42;
    if (a != -42) return false;

    var b = -1;
    if (b != -1) return false;

    // verify in expressions
    var c = 10 + -3;
    if (c != 7) return false;

    var d = -100 + 50;
    if (d != -50) return false;

    // double negation
    var e = -(-5);
    if (e != 5) return false;

    // float
    var f = -3.14;
    if (f > -3.13 || f < -3.15) return false;

    return true;
}
