#unittest {
	name: "Math.random integer range correctness.";
	result: true;
};

func main() {
    var i = 0;
    while (i < 100) {
        var r = Math.random(5, 15);
        if (r < 5 || r > 15) return false;
        i += 1;
    }

    // equal bounds
    var r2 = Math.random(7, 7);
    if (r2 != 7) return false;

    return true;
}
