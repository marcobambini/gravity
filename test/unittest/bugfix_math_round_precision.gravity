#unittest {
	name: "Math.round with decimal digits.";
	result: true;
};

func main() {
    // round to 2 decimal places
    var r1 = Math.round(3.14159, 2);
    if (r1 < 3.13 || r1 > 3.15) return false;

    // round to 0 decimal places (integer)
    var r2 = Math.round(3.7, 0);
    if (r2 < 3.9 || r2 > 4.1) return false;

    // round to 1 decimal place
    var r3 = Math.round(2.55, 1);
    if (r3 < 2.5 || r3 > 2.7) return false;

    // negative value
    var r4 = Math.round(-1.5);
    if (r4 < -2.1 || r4 > -1.4) return false;

    return true;
}
